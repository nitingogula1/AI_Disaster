APP_NAME=SentinelAid AI
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Primary Database (MySQL with automatic SQLite fallback for zero-setup execution)
DATABASE_URL=sqlite:///./sentinelaid.db
SQL_ECHO=False

# JWT Security (Generate a secure key using: openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-random-64-character-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://localhost:8000"]

# File Storage
UPLOAD_DIR=uploads
PROCESSED_DIR=processed
REPORT_DIR=reports

# Satellite Provider Credentials
NASA_API_KEY=YOUR_NASA_API_KEY_HERE
USGS_API_KEY=YOUR_USGS_API_KEY_HERE
COPERNICUS_CLIENT_ID=YOUR_COPERNICUS_CLIENT_ID
COPERNICUS_CLIENT_SECRET=YOUR_COPERNICUS_CLIENT_SECRET
PLANETARY_COMPUTER_URL=https://planetarycomputer.microsoft.com/api/stac/v1

# Routing Engine
ROUTING_PROVIDER_URL=
ROUTING_PROVIDER_KEY=
